flowchart TD
    IN(["⚙️ AgentExecutor.execute 或 resume"]) --> VALID["再次校验计划<br/>resume 复用未被修改的成功步骤"]
    VALID --> STATE["建立本轮内存状态与 pending<br/>成功结果保留供绑定"]
    STATE --> STOP{"已取消或总时间耗尽"}
    STOP -->|"是"| CANCEL["标记未开始步骤<br/>收尾或中断运行步骤"]
    STOP -->|"否"| READY["按计划顺序选择就绪步骤<br/>依赖全部成功，单批最多四个"]
    READY --> ANY{"存在就绪步骤"}
    ANY -->|"否"| SKIP["剩余步骤标记 SKIPPED"]
    ANY -->|"是"| SUBMIT["先标记 RUNNING<br/>独立线程池执行当前批次"]
    SUBMIT --> BIND["PlanInputBinder.bind<br/>逐个字段读取声明来源"]
    BIND --> SOURCE{"来源类型"}
    SOURCE -->|"CONSTANT"| CONST["读取固定常量"]
    SOURCE -->|"USER_INPUT"| USER["按路径读取可信用户输入"]
    SOURCE -->|"STEP_OUTPUT"| UP["要求上游 SUCCEEDED<br/>只读 result.output 的明确字段"]
    CONST --> PUT["检查字段存在、非空与目标路径冲突<br/>构造当前步骤 input Map"]
    USER --> PUT
    UP --> PUT
    PUT --> RT["CapabilityInvocation key/input<br/>交给 04 Runtime"]
    RT --> COLLECT["完成队列按实际完成顺序取结果<br/>更新状态并快照证据"]
    COLLECT --> FAILED{"当前批次出现失败"}
    FAILED -->|"是"| SKIP
    FAILED -->|"否且仍有待执行"| STOP
    FAILED -->|"否且全部完成"| OUT["返回最终快照<br/>移除活动状态和进度监听"]
    SKIP --> OUT
    CANCEL --> OUT
    SUBMIT -. 线程池拒绝 .-> SKIP
    BIND -. 输入绑定异常 .-> COLLECT

    classDef process fill:#E8F1FF,stroke:#245DA8,color:#16365D
    classDef model fill:#EEE6FA,stroke:#7450A0,color:#432563
    classDef decision fill:#FFF2CC,stroke:#997000,color:#594100
    classDef data fill:#E2F0D9,stroke:#477A30,color:#24451B
    classDef failure fill:#FCE4D6,stroke:#AA4B27,color:#682A12
    class VALID,STATE,READY,SUBMIT,BIND,CONST,USER,UP,PUT,RT,COLLECT process
    class STOP,ANY,SOURCE,FAILED decision
    class CANCEL,SKIP failure
    class OUT data
